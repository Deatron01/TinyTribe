# ---- Unity (project lives in Game/TinyTribe/) ----
# Only scripts are tracked inside Game/: C# files and assembly definitions.
# Scenes, prefabs, art, .meta files, Packages/ and ProjectSettings/ are NOT saved.
Game/**
!Game/**/
!Game/**/*.cs
!Game/**/*.asmdef

# Generated folders stay ignored even though they contain .cs files
Game/**/[Ll]ibrary/
Game/**/[Tt]emp/
Game/**/[Oo]bj/
Game/**/[Bb]uild/
Game/**/[Bb]uilds/
Game/**/[Ll]ogs/
Game/**/[Uu]ser[Ss]ettings/
Game/**/[Mm]emoryCaptures/
Game/**/[Rr]ecordings/

# Autogenerated solution and project files
Game/**/.vs/
Game/**/.vscode/
Game/**/.idea/
Game/**/.gradle/
Game/**/ExportedObj/
Game/**/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
Game/**/crashlytics-build.properties

# Packed Addressables
Game/**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
Game/**/[Aa]ssets/[Ss]treamingAssets/aa.meta
Game/**/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Python (ML/ and Server/) ----
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Recorded play logs, training runs and checkpoints (not tracked)
ML/data/
ML/runs/
ML/checkpoints/
ML/results/
*.pt
*.pth
*.ckpt

# ---- Secrets and local config ----
.env
.env.*
!.env.example

# ---- Office lock files ----
~$*

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- Claude Code local settings ----
.claude/settings.local.json

# ---- The standalone simulation program (ML/host) ----
# Its project file is ours (the rule above ignores every .csproj); its build output is not.
!ML/host/*.csproj
ML/host/bin/
ML/host/obj/
# Experiments keep their settings, numbers and curves; the weights are rebuilt by running the experiment again.
ML/experiments/**/*.pt

# The Edit-mode tests built without Unity
ML/tests/bin/
ML/tests/obj/

# Copies of the simulator and its data set aside for a long run
ML/host/frozen*/
